{
  "name": "@maschinenlesbar.org/regionalstatistik-cli",
  "version": "0.0.3",
  "description": "TypeScript API client and CLI for the Regionaldatenbank Deutschland GENESIS REST API (www.regionalstatistik.de)",
  "type": "module",
  "bin": {
    "regstat": "dist/src/cli/index.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "LICENSING.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "docs": "typedoc src/index.ts --out out",
    "start": "node dist/src/cli/index.js"
  },
  "keywords": [
    "regionalstatistik",
    "regionaldatenbank",
    "genesis",
    "genesis-online",
    "statistik",
    "official-statistics",
    "regional-statistics",
    "kreise",
    "gemeinden",
    "opendata",
    "germany",
    "cli",
    "api-client"
  ],
  "author": "Sebastian Schürmann <sebs@2xs.org>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maschinenlesbar-org/regionalstatistik-cli.git"
  },
  "bugs": {
    "url": "https://github.com/maschinenlesbar-org/regionalstatistik-cli/issues"
  },
  "homepage": "https://github.com/maschinenlesbar-org/regionalstatistik-cli#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/sebs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  }
}
